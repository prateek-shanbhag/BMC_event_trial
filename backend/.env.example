# Backend Server Port (Render sets PORT automatically)
PORT=5000

# Frontend URL for CORS (Set to Firebase Hosting staging URL on Render)
# Do NOT use '*' in production/staging. Comma-separated origins are supported.
FRONTEND_URL=https://your-staging-site.web.app

# Firebase Admin SDK Credentials
# -----------------------------------------------------------------------------
# OPTION A: Hosted Staging / Production on Render (Environment Variables)
# Obtain these values from Firebase Console > Project settings > Service accounts
# > Generate new private key (JSON file). The private key must NEVER be committed.
FIREBASE_PROJECT_ID="your-staging-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-staging-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# OPTION B: Local Development (File path outside the repository)
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"

# Automated Test Script Credentials (backend/scripts/*)
FIREBASE_WEB_API_KEY="your_firebase_web_api_key_here"
TEST_ADMIN_EMAIL="admin@example.com"
TEST_ADMIN_PASSWORD="your_test_admin_password_here"
TEST_PARTICIPANT_EMAIL="participant@example.com"
TEST_PARTICIPANT_PASSWORD="your_test_participant_password_here"
TEST_PARTICIPANT_2_EMAIL="participant2@example.com"
TEST_PARTICIPANT_2_PASSWORD="your_test_participant_2_password_here"

# Destructive Script Guards (Required to run reset-db or destructive test suites)
# NEVER set to true against staging or production!
ALLOW_DESTRUCTIVE_TESTS=false
TEST_FIREBASE_PROJECT_ID="your_test_firebase_project_id_here"
