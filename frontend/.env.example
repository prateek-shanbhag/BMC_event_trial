# Firebase Web Client Configuration (From Firebase Console > Project settings > General > Your apps)
VITE_FIREBASE_API_KEY="your_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="your-staging-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-staging-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-staging-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id_here"
VITE_FIREBASE_APP_ID="your_app_id_here"

# Backend API URL (Points to Render Web Service in Staging/Production)
VITE_API_BASE_URL=https://your-render-service.onrender.com
# For Local Development:
# VITE_API_BASE_URL=http://localhost:5000